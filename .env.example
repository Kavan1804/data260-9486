# Copy to .env (repo root) and fill in your own MySQL credentials. Never commit .env.
DATABASE_URL=mysql+pymysql://USERNAME:PASSWORD@localhost:3306/s9486_rel

# Optional overrides
LLM_MODEL=llama3.2:3b
OLLAMA_URL=http://localhost:11434
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# HW6 - MongoDB (professor's Homework6/long-term-memory/docker-compose.yml publishes 27017)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=s9486_doc

# HW6 - memory. Values that still start with "<" are treated as unset.
# OLLAMA_MODEL unset -> the HW5 LLM_MODEL above is used. Check with: ollama list
OLLAMA_MODEL=<I_MUST_PROVIDE_MODEL_NAME>
# Unset -> local hashed bag-of-words embedding (hash-bow-256). Only set this to a model
# that `ollama list` already shows; nothing new has to be pulled.
OLLAMA_EMBED_MODEL=<I_MUST_PROVIDE_EMBEDDING_MODEL_NAME>
OLLAMA_NUM_CTX=8192
SHORT_TERM_N=12
SUMMARIZE_EVERY_USER_MSGS=5
EPISODIC_TOP_K=3

# HW7 - JWT auth. Generate your own values; never commit the real .env.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=<generate-a-long-random-string>
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Passwords for the three seeded HW7 test users (scripts/migrate_hw07.py)
HW7_READER_PASSWORD=<choose-a-password>
HW7_WRITER_PASSWORD=<choose-a-password>
HW7_MODERATOR_PASSWORD=<choose-a-password>
